---
import BaseLayout from '../layouts/BaseLayout.astro';
import Band from '../components/Band.astro';
import { href } from '../lib/urls';
---

<BaseLayout title="Page not found" description="That page has wandered off.">
  <Band tone="lilac">
    <h1>Lost in the stars</h1>
    <p>That page doesn't exist — it may have moved, or the link might be a little old.</p>
    <p class="back"><a href={href('/')}>Head back home →</a></p>
  </Band>
</BaseLayout>

<style>
  h1 { font-size: var(--size-hero); margin-bottom: 0.75rem; }
  .back { margin-top: 1.5rem; font-family: var(--font-display); font-weight: 700; font-size: 1.15rem; }
</style>
