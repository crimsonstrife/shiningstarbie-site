---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Band from '../../components/Band.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import WorkMedia from '../../components/WorkMedia.astro';
import { byDate, includeDrafts, formatDate } from '../../lib/content';
import { href } from '../../lib/urls';

const works = (await getCollection('works', ({ data }) => includeDrafts || !data.draft)).sort(byDate);

const KINDS = [
  { id: 'art', label: 'Art', hue: 'pink' },
  { id: 'music', label: 'Music', hue: 'purple' },
  { id: 'sound', label: 'Sound design', hue: 'teal' },
] as const;

const present = KINDS.filter((k) => works.some((w) => w.data.kind === k.id));
---

<BaseLayout title="Works" description="Art, music, and sound design by starbie.">
  <Band tone="mint" divider="white">
    <SectionHeading eyebrow="Things I've made" title="Works" hue="terracotta" as="h1" />
    {works.length > 0 ? (
      <div class="filters">
        <button type="button" class="chip is-active" data-filter="all">Everything</button>
        {present.map((k) => (
          <button type="button" class="chip" data-filter={k.id} style={`--hue:var(--c-${k.hue})`}>{k.label}</button>
        ))}
      </div>
    ) : (
      <p>Nothing here just yet — check back soon!</p>
    )}
  </Band>

  {works.length > 0 && (
    <Band tone="white" texture="grid">
      <ul class="grid" id="works-grid">
        {works.map((w) => (
          <li data-kind={w.data.kind}>
            <a href={href(`/works/${w.id}`)}>
              <WorkMedia media={w.data.media} title={w.data.title} />
              <span class="title">{w.data.title}</span>
              <span class="meta">{formatDate(w.data.date)}{w.data.draft ? ' · Draft' : ''}</span>
              {w.data.summary && <span class="summary">{w.data.summary}</span>}
            </a>
          </li>
        ))}
      </ul>
      <p class="empty" hidden>No works in that category yet.</p>
    </Band>
  )}
</BaseLayout>

<script>
  const chips = document.querySelectorAll<HTMLButtonElement>('.chip');
  const items = document.querySelectorAll<HTMLLIElement>('#works-grid li');
  const empty = document.querySelector<HTMLParagraphElement>('.empty');

  chips.forEach((chip) =>
    chip.addEventListener('click', () => {
      const filter = chip.dataset.filter;
      chips.forEach((c) => c.classList.toggle('is-active', c === chip));

      let shown = 0;
      items.forEach((li) => {
        const match = filter === 'all' || li.dataset.kind === filter;
        li.hidden = !match;
        if (match) shown++;
      });

      if (empty) empty.hidden = shown > 0;
    })
  );
</script>

<style>
  .filters { display: flex; flex-wrap: wrap; gap: 0.6rem; }

  .chip {
    padding: 0.5rem 1.15rem;
    border-radius: var(--radius);
    border: 3px solid var(--color-line);
    background: var(--color-cloud);
    color: var(--color-line);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.95rem;
    cursor: pointer;
    transition: background var(--dur-fast) var(--ease);
  }

  .chip:hover { background: var(--hue, var(--c-lilac)); }
  .chip.is-active { background: var(--hue, var(--color-line)); color: var(--color-line); }
  .chip.is-active[data-filter='all'] { background: var(--color-line); color: #fff; }

  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(1.75rem, 4vw, 2.75rem);
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
  }

  /* Keep the image on the band with its caption below. It doesn't need another
     panel, border, and padding box around it. */
  .grid a { display: grid; gap: 0.4rem; color: inherit; text-decoration: none; }
  .title { font-family: var(--font-display); font-weight: 700; font-size: 1.2rem; margin-top: 0.35rem; }
  .meta { font-size: 0.8rem; letter-spacing: var(--tracking-label); text-transform: uppercase; color: var(--color-ink-soft); }
  .summary { font-size: var(--size-small); color: var(--color-ink-soft); }
  .grid a:hover .title { text-decoration: underline; text-decoration-thickness: 0.14em; text-underline-offset: 0.16em; }

  .empty { margin-top: 1rem; color: var(--color-ink-soft); }
</style>
